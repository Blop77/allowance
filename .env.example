# --- AI for the buying agent: Gemini (free tier) or Claude ---
# Which provider to use: gemini or claude. If unset: Gemini when GEMINI_API_KEY is set, otherwise Claude.
AI_PROVIDER=
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: defaults to gemini-2.5-flash
GEMINI_MODEL=

# --- Optional: Claude (Anthropic API) ---
ANTHROPIC_API_KEY=
# Only needed if your key is not scoped to a workspace (console.anthropic.com -> Settings -> Workspaces)
ANTHROPIC_WORKSPACE_ID=

# --- Required: PayPal sandbox REST app (developer.paypal.com -> Apps & Credentials -> Sandbox) ---
# In the app's settings, enable "Save payment methods" (Vault).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: set after creating a webhook in the PayPal dashboard pointing to <APP_URL>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=

# --- Optional: Channel3 product search (trychannel3.com/developers). Without it, a built-in sample catalog is used. ---
CHANNEL3_API_KEY=

# Public URL of this app (used for PayPal return URLs)
APP_URL=http://localhost:3000

# Where the SQLite database lives
DATABASE_PATH=./data/allowance.db
